<?php
declare(strict_types=1);

header('Content-Type: application/json; charset=utf-8');
header('Access-Control-Allow-Methods: GET, POST, PATCH, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(204);
    exit;
}

require_once __DIR__ . '/../config/database.php';

function respond($data, int $status = 200): void {
    http_response_code($status);
    echo json_encode($data, JSON_UNESCAPED_UNICODE);
    exit;
}

function getJsonBody(): array {
    $raw = file_get_contents('php://input');
    $data = json_decode($raw ?: '{}', true);
    if (!is_array($data)) respond(['error' => 'Invalid JSON request body.'], 400);
    return $data;
}

try {
    $method = $_SERVER['REQUEST_METHOD'];

    if ($method === 'GET') {
        $stmt = $pdo->query('SELECT id, title, description, completed, created_at FROM tasks ORDER BY id DESC');
        respond($stmt->fetchAll());
    }

    if ($method === 'POST') {
        $data = getJsonBody();
        $title = trim((string)($data['title'] ?? ''));
        $description = trim((string)($data['description'] ?? ''));

        if ($title === '') respond(['error' => 'Task title is required.'], 422);
        if (mb_strlen($title) > 180) respond(['error' => 'Task title must be 180 characters or fewer.'], 422);
        if (mb_strlen($description) > 500) respond(['error' => 'Description must be 500 characters or fewer.'], 422);

        $stmt = $pdo->prepare('INSERT INTO tasks (title, description) VALUES (:title, :description)');
        $stmt->execute(['title' => $title, 'description' => $description]);
        $id = (int)$pdo->lastInsertId();
        $stmt = $pdo->prepare('SELECT id, title, description, completed, created_at FROM tasks WHERE id = ?');
        $stmt->execute([$id]);
        respond($stmt->fetch(), 201);
    }

    $id = filter_input(INPUT_GET, 'id', FILTER_VALIDATE_INT);
    if (!$id || $id < 1) respond(['error' => 'A valid task id is required in the query string.'], 400);

    if ($method === 'PATCH') {
        $data = getJsonBody();
        if (!array_key_exists('completed', $data) || !in_array((int)$data['completed'], [0, 1], true)) {
            respond(['error' => 'completed must be 0 or 1.'], 422);
        }
        $stmt = $pdo->prepare('UPDATE tasks SET completed = :completed WHERE id = :id');
        $stmt->execute(['completed' => (int)$data['completed'], 'id' => $id]);
        if ($stmt->rowCount() === 0) {
            $check = $pdo->prepare('SELECT id FROM tasks WHERE id = ?');
            $check->execute([$id]);
            if (!$check->fetch()) respond(['error' => 'Task not found.'], 404);
        }
        $stmt = $pdo->prepare('SELECT id, title, description, completed, created_at FROM tasks WHERE id = ?');
        $stmt->execute([$id]);
        respond($stmt->fetch());
    }

    if ($method === 'DELETE') {
        $stmt = $pdo->prepare('DELETE FROM tasks WHERE id = ?');
        $stmt->execute([$id]);
        if ($stmt->rowCount() === 0) respond(['error' => 'Task not found.'], 404);
        respond(['message' => 'Task deleted successfully.']);
    }

    header('Allow: GET, POST, PATCH, DELETE, OPTIONS');
    respond(['error' => 'Method not allowed.'], 405);
} catch (PDOException $e) {
    error_log($e->getMessage());
    respond(['error' => 'Database error. Check config/database.php and import database.sql.'], 500);
} catch (Throwable $e) {
    error_log($e->getMessage());
    respond(['error' => 'Server error. Please try again.'], 500);
}